# Postgres — local dev; point this at Supabase Postgres in production
# (only this value changes between environments)
DATABASE_URL="postgresql://postgres:root@localhost:5432/agni_omega"

# NextAuth
AUTH_SECRET="generate-with: npx auth secret"
NEXTAUTH_URL="http://localhost:3000"

# Public site URL — used for canonical links, JSON-LD, sitemap.xml, robots.txt
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google OAuth (buyer sign-in only)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Supabase Storage (product/shop images)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Resend (transactional email)
RESEND_API_KEY=""

# Seed script (optional — defaults shown)
SEED_ADMIN_EMAIL="admin@agniomega.com"
SEED_ADMIN_PASSWORD="changeme123"
